{
  "name": "red-core",
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview --port 8080",
    "party": "partykit dev",
    "rig:check": "node tools/check-rig.mjs assets/ozk.glb",
    "map:check": "node tools/check-map.mjs",
    "check": "for t in chess-safe collision evolution map reactor relay sewer stations movement bots; do node tools/check-$t.mjs || exit 1; done",
    "deploy": "npm run build:all",
    "build:server": "esbuild server/node.ts --bundle --platform=node --format=esm --outfile=build/server.mjs --banner:js=\"import {createRequire} from 'module';const require=createRequire(import.meta.url);\"",
    "build:all": "vite build && npm run build:server",
    "start": "node build/server.mjs"
  },
  "dependencies": {
    "partysocket": "1.1.3",
    "qrcode-generator": "^1.4.4",
    "three": "0.160.0",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "partykit": "0.0.112",
    "typescript": "5.5.4",
    "vite": "6.3.5"
  }
}